# Telegram Bot Token (required)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database (optional, defaults to SQLite file)
# SQLite: ./data/fyndbot.db
# Postgres: postgresql://user:pass@host:5432/fyndbot
DATABASE_URL=./data/fyndbot.db

# LLM API for bargain scoring (optional)
# OpenAI-compatible endpoint (e.g., OpenRouter, OpenAI)
# If missing, uses deterministic heuristic scoring
LLM_API_KEY=
LLM_API_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini

# Stripe for Pro tier (optional)
# Create price in Stripe Dashboard: 79 SEK/month recurring subscription
# Set webhook endpoint: https://fynd.vome.io/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FYNDBOT_PRO=price_xxxxxxxxxxxxx

# Stripe TEST mode (optional, for sandbox testing)
# Only users in the sandbox allowlist will use these test keys
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_FYNDBOT_PRO=price_xxxxxxxxxxxxx

# Stripe Sandbox Allowlist (optional)
# Comma-separated telegram IDs and usernames (case-insensitive)
# Example: STRIPE_SANDBOX_TELEGRAM_IDS=6416786982,123456789
# Example: STRIPE_SANDBOX_USERNAMES=Rotwang9000,TestUser
STRIPE_SANDBOX_TELEGRAM_IDS=6416786982
STRIPE_SANDBOX_USERNAMES=Rotwang9000

# Public base URL (used for Stripe success/cancel redirects)
PUBLIC_BASE_URL=https://fynd.vome.io

# Pricing constants (SEK)
PRICE_FREE=0
PRICE_PRO_MONTHLY=79
PRICE_INSPECT=19

# Rate limits
POLL_INTERVAL_MINUTES=2
FREE_INSPECT_WEEKLY_LIMIT=3

# Development
NODE_ENV=development
LOG_LEVEL=info
