{
	"name": "fyndbot",
	"version": "1.0.0",
	"description": "Swedish Blocket.se Telegram alert bot MVP",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"test": "NODE_OPTIONS='--experimental-vm-modules' jest",
		"test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
		"lint": "eslint src/**/*.ts"
	},
	"keywords": [
		"blocket",
		"telegram",
		"bot",
		"sweden"
	],
	"author": "Andrew Hancock",
	"license": "MIT",
	"dependencies": {
		"better-sqlite3": "^11.7.0",
		"dotenv": "^16.4.5",
		"node-telegram-bot-api": "^0.66.0",
		"node-fetch": "^3.3.2",
		"stripe": "^17.4.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.12",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.2",
		"@types/node-telegram-bot-api": "^0.64.7",
		"@typescript-eslint/eslint-plugin": "^8.18.2",
		"@typescript-eslint/parser": "^8.18.2",
		"eslint": "^9.17.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
